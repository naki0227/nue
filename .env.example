# Everything works without any key: analysis runs locally (FFmpeg + whisper.cpp).

# Optional: Gemini as the AI editor (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# auto (Gemini if a key is set) | local | gemini
NUE_ANALYZER=auto

# Subtitles: speech language (auto, ja, en, ...) and bundled whisper model
# (tiny | base | small | medium | none). Rebuild after changing WHISPER_MODEL.
NUE_LANGUAGE=auto
WHISPER_MODEL=small
