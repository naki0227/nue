{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/naki0227/nue/docs/edit-plan.schema.json",
  "title": "Nue edit plan",
  "description": "Contract between analyzers (local, Gemini, iOS on-device) and renderers (Rust/FFmpeg, AVFoundation). All times are positions in the SOURCE video, written HH:MM:SS or HH:MM:SS.mmm.",
  "type": "object",
  "required": ["original_filename", "cuts"],
  "$defs": {
    "time": { "type": "string", "pattern": "^\\d{1,2}:\\d{2}:\\d{2}([.,]\\d{1,3})?$" },
    "style": {
      "type": "object",
      "properties": {
        "font": { "enum": ["sans", "serif"] },
        "color": { "enum": ["white", "yellow", "cyan", "blue", "red", "pink", "green", "orange", "black"] },
        "position": { "enum": ["top", "center", "middle", "bottom"] },
        "box": { "type": "boolean" },
        "size": { "enum": ["normal", "large", null], "description": "large is used for opening titles" },
        "background_asset": { "type": "string" }
      }
    },
    "timedText": {
      "type": "object",
      "required": ["start", "end", "text"],
      "properties": {
        "start": { "$ref": "#/$defs/time" },
        "end": { "$ref": "#/$defs/time" },
        "text": { "type": "string" },
        "style": { "$ref": "#/$defs/style" }
      }
    }
  },
  "properties": {
    "job_id": { "type": ["string", "null"] },
    "original_filename": { "type": "string" },
    "analyzer": { "enum": ["local", "gemini", "ios", "external", null] },
    "format": { "enum": ["vertical", "horizontal", "square", null] },
    "bgm_path": { "type": ["string", "null"], "description": "Path or file name under data/bgm" },
    "cuts": {
      "type": "array",
      "minItems": 1,
      "description": "Ranges to KEEP, in playback order",
      "items": {
        "type": "object",
        "required": ["start_time", "end_time"],
        "properties": {
          "start_time": { "$ref": "#/$defs/time" },
          "end_time": { "$ref": "#/$defs/time" },
          "description": { "type": ["string", "null"] },
          "caption": { "type": ["string", "null"], "description": "Legacy: text shown for the whole cut" },
          "caption_style": { "$ref": "#/$defs/style" },
          "focus_point": { "type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "Horizontal center of the subject; vertical crops are centered on it" }
        }
      }
    },
    "editing_style": { "type": ["object", "null"] },
    "se_events": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["timestamp", "type"],
        "properties": {
          "timestamp": { "$ref": "#/$defs/time" },
          "type": { "type": "string", "description": "File stem in data/se (impact, whoosh, pop, ding, boing, buzzer, sparkle, ...) or an alias" },
          "tag": { "type": ["string", "null"] }
        }
      }
    },
    "visual_effects": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["start", "type"],
        "properties": {
          "start": { "$ref": "#/$defs/time" },
          "end": { "$ref": "#/$defs/time" },
          "type": { "enum": ["zoom_in", "zoom_out", "pan_left", "pan_right", "punch_in", "push_in"], "description": "punch_in: 1.12x for a whole cut (alternated across jump cuts); push_in: slow 6% push over a cut" },
          "speed": { "type": ["string", "null"] }
        }
      }
    },
    "telops": { "type": ["array", "null"], "items": { "$ref": "#/$defs/timedText" }, "description": "Emphasis captions" },
    "subtitles": { "type": ["array", "null"], "items": { "$ref": "#/$defs/timedText" }, "description": "Speech transcript lines" },
    "overlays": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["asset", "start", "end"],
        "properties": {
          "asset": { "type": "string", "description": "File stem in data/icons" },
          "start": { "$ref": "#/$defs/time" },
          "end": { "$ref": "#/$defs/time" },
          "position": { "enum": ["top_left", "top_right", "bottom_left", "bottom_right", "center"] },
          "scale": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
        }
      }
    },
    "thumbnail": {
      "type": ["object", "null"],
      "required": ["timestamp"],
      "properties": {
        "timestamp": { "$ref": "#/$defs/time" },
        "text": { "type": "string" },
        "color": { "type": ["string", "null"] }
      }
    },
    "options": {
      "type": "object",
      "properties": {
        "bgm": { "type": "boolean" },
        "sound_effects": { "type": "boolean" },
        "subtitles": { "type": "boolean" }
      }
    }
  }
}
